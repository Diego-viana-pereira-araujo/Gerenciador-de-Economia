<script>
      var Recebimento = window.prompt("Digite quanto dinheiro você recebeu");
      var Recebimento = parseFloat(Recebimento);

      var Lazer = Recebimento * 0.1;
      var Cofre = Recebimento * 0.9;

      document.write("<h2>Seu saldo atual:</h2>");
      document.write(`Conta Lazer: R$ ${Lazer.toFixed(2)} reais<br>`);
      document.write(`Conta Cofre: R$ ${Cofre.toFixed(2)} reais<br>`);
      document.write(
        "<br><strong>Legenda:</strong><br>Conta lazer é destinada a comprar coisas que sejam agradaveis ao usuario<br>Conta cofre é destinada a polpar o dinheiro para poder ser gasto com algo grande e/ou importante no futuro",
      );

      var nomeUser = getElementById("nomeUsuario");
      document.write(`Nome do usuario: ${nomeUser}`);
    </script>
